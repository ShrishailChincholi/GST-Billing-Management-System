# ============================================
# GST IMS - Frontend .gitignore
# ============================================

# ===== Dependencies =====
/node_modules
/.pnp
.pnp.js
package-lock.json
yarn.lock
pnpm-lock.yaml

# ===== Production Build =====
/build
/dist
/out

# ===== Environment Variables =====
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# Keep example
!.env.example

# ===== Testing =====
/coverage
.nyc_output/

# ===== Misc =====
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ===== Editor =====
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.iml

# ===== Create React App =====
# (these are auto-generated and should not be committed)
/config/env.js
/config/getHttpsConfig.js
/config/jest
/config/paths.js
/config/pnpTs.js
/config/setupTests.js
/config/webpack.config.js
/config/webpackDevServer.config.js
/config/modules.js
/scripts/build.js
/scripts/start.js
/scripts/test.js
/scripts/eject.js

# Except CRA default configs are typically committed
!config/env.js
!config/paths.js
!config/webpack.config.js

# ===== Vercel / Netlify =====
.vercel
.netlify

# ===== Misc =====
.eslintcache
.node_repl_history