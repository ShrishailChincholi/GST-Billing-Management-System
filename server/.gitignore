# ============================================
# GST IMS - Backend .gitignore
# ============================================

# ===== Dependencies =====
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# ===== Environment Variables (SENSITIVE!) =====
.env
.env.local
.env.development
.env.staging
.env.production
.env.test
.env.*.local
*.env

# Keep the example file
!.env.example

# ===== Logs =====
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pm2/
.pm2/

# ===== Runtime Data =====
pids/
*.pid
*.seed
*.pid.lock
lib-cov/
coverage/
.nyc_output/

# ===== Build =====
build/
dist/
out/

# ===== Uploads / User Files =====
uploads/
public/uploads/
generated-pdfs/
temp-pdfs/

# ===== Database =====
data/
db/
*.sqlite
*.sqlite3
*.db
dump/
mongodb-data/

# ===== Puppeteer / Chromium Cache =====
.cache/
puppeteer/
.node/
chromium/

# ===== SSL / Secrets =====
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
credentials.json
service-account.json

# ===== Test =====
coverage/
.nyc_output/
*.lcov

# ===== Editor =====
.vscode/
.idea/
*.swp
*.swo
*.iml

# ===== OS =====
.DS_Store
Thumbs.db
Desktop.ini

# ===== Misc =====
.eslintcache
.node_repl_history
.tmp/